{
  "name": "discord-moderation-backend",
  "version": "1.0.0",
  "description": "GMW — Discord moderation backend: HTTP/oRPC dashboard, Discord capture, and the moderation worker in one process",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc && node scripts/fix-imports.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/migrateCli.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx watch src/index.ts",
    "format": "biome format --write .",
    "lint": "biome check --diagnostic-level=error .",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@orpc/server": "1.16.2",
    "axios": "^1.21.0",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.3",
    "openai": "^7.53.0",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
