{
  "name": "frontend",
  "version": "0.1.0",
  "description": "GMW frontend — React 19 + Vite SPA for Discord moderation monitoring",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "format": "biome format --write .",
    "lint": "biome check . && oxlint",
    "preview": "vite preview",
    "start": "vite preview --host 127.0.0.1 --port 4017",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@orpc/client": "1.16.2",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "gsap": "^3.15.1",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "partysocket": "1.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/vite": "^4",
    "@tanstack/router-cli": "1.168.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "oxlint": "^1.92.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vite": "^8",
    "vitest": "^5.1.0"
  }
}
