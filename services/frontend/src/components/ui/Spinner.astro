---
export interface Props {
  size?: "sm" | "default" | "lg";
  class?: string;
}

const { size = "default", class: className = "" } = Astro.props;
---

<span
  aria-label="Loading"
  role="status"
  class:list={[`spinner spinner--${size}`, className]}
>
  <span class="spinner__ring" aria-hidden="true" />
</span>

<style is:global>
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .spinner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: middle;
  }

  .spinner__ring {
    display: block;
    border-radius: 50%;
    border-style: solid;
    border-color: oklch(var(--muted));
    border-top-color: oklch(var(--primary));
    animation: spin 0.6s linear infinite;
  }

  /* ── Sizes ─────────────────────────────────────── */

  .spinner--sm .spinner__ring {
    width: 1rem;
    height: 1rem;
    border-width: 2px;
  }

  .spinner--default .spinner__ring {
    width: 1.5rem;
    height: 1.5rem;
    border-width: 2.5px;
  }

  .spinner--lg .spinner__ring {
    width: 2.5rem;
    height: 2.5rem;
    border-width: 3px;
  }
</style>
