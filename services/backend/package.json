{
  "name": "discord-moderation-backend",
  "version": "1.0.0",
  "description": "Backend service for Discord moderation monitoring",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --diagnostic-level=error .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@bete/shared": "workspace:*",
    "@discordjs/voice": "^0.19.2",
    "@types/pg": "^8.20.0",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.0",
    "pg": "^8.21.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "ws": "^8.20.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.2",
    "typescript": "^5.9.3",
    "vitest": "latest"
  }
}
