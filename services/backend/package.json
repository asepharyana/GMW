{
  "name": "discord-moderation-backend",
  "version": "1.0.0",
  "description": "Backend service for Discord moderation monitoring",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --diagnostic-level=error .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@orpc/server": "1.15.0",
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "ws": "^8.21.3",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "latest"
  }
}
